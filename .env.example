# The authoritative deployment is the backend-free GitHub Pages build, which
# holds NO server keys at all: every user brings their own key in the browser
# (BYO), and it is used for direct provider calls and never persisted. This file
# only matters for OPTIONAL self-hosting of the FastAPI backend — none of these
# keys are required, and the app never bakes a token into the shipped site.
#
# Everything is optional: with no LLM keys, bundled exemplar sessions still carry
# precomputed demo scores. Live grading of a new essay+trace assessment needs a
# provider — a user's own browser-supplied key in Settings (the default model),
# or, only if you self-host, one of the optional server keys below.

# ── Optional self-host server keys (never exposed to the browser) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
# Texas A&M AI gateway (chat.tamu.ai → Settings → API Keys). One key reaches
# OpenAI/Anthropic/Gemini models under campus licensing. TAMU_CHAT_API_KEY is
# accepted as an alias. Override the endpoint only if TAMU moves it.
TAMU_AI_API_KEY=
#TAMU_AI_BASE_URL=https://chat-api.tamu.ai/openai
# Ollama needs no key — it is auto-detected at http://localhost:11434

# Default provider shown in pickers (OpenAI | Claude | Gemini | Groq | Mistral |
# GitHub Models | TAMU AI | Ollama)
DEFAULT_PROVIDER=Claude

# ── Storage ────────────────────────────────────────────────────────────────────
# Directory for the SQLite database and generated artifacts (default: backend/data)
#ASSESSMENT_DATA_DIR=
# Full override for the database file path
#ASSESSMENT_DB_PATH=
